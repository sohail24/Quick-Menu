		{
			"name": "Orders (IDEMPOTENT)",
			"item": [
				{
					"name": "Place Order (Customer - Idempotent)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"try {",
									"  const json = pm.response.json();",
									"  if (json && json.id) {",
									"    pm.environment.set(\"orderId\", json.id);",
									"    console.log(\"Order Created/Retrieved with ID:\", json.id);",
									"  }",
									"} catch (e) {}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"tableId\": \"{{tableId}}\",\n  \"customerName\": \"Idempotent John\",\n  \"customerPhone\": \"9876543210\",\n  \"items\": [{ \"dishId\": \"{{dishId}}\", \"quantity\": 2, \"note\": \"spicy\" }],\n  \"discountStrategy\": \"HAPPY_HOUR\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/{{restaurantId}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"{{restaurantId}}",
								"orders"
							]
						},
						"description": "This request is IDEMPOTENT. If you send the same {{requestId}} twice, the server will return the existing order instead of creating a duplicate."
					},
					"response": []
				},
