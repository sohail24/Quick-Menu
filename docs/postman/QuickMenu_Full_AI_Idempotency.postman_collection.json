								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/ai/dish-description?dishName=Spicy%20Paneer%20Burger&category=Burgers",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ai",
								"dish-description"
							],
							"query": [
