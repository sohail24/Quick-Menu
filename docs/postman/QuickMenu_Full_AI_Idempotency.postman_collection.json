{
	"info": {
		"_postman_id": "e91eefeb-2aab-4189-a7f4-966c37908b4d",
		"name": "Quick Menu - API V2 (Full AI & Idempotency)",
		"description": "Updated Postman collection for Quick Menu. Includes Authentication, Restaurant Management, Menu Management, Orders (Idempotent), Real-time Bells, and new AI Features (Descriptions, Insights, Images).\n\nSet {{baseUrl}} (default http://localhost:8080) and use the 'Auth' folder to obtain a token.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "32596693"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Signup (auto-login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Signup: save token if returned",
									"try {",
									"  const json = pm.response.json();",
									"  if (json && json.token) {",
									"    pm.environment.set(\"token\", json.token);",
									"    pm.environment.set(\"authHeader\", \"Bearer \" + json.token);",
									"    console.log(\"Saved token from signup\");",
									"  }",
									"} catch (e) {",
									"  console.log(\"No JSON body or token not found\");",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Owner\",\n  \"email\": \"owner@qm.local\",\n  \"password\": \"Owner123!\",\n  \"role\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/signup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"signup"
							]
						},
						"description": "Registers and returns an access token (auto-login)."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Login: save token automatically",
									"try {",
									"  const json = pm.response.json();",
									"  if (json && json.token) {",
									"    pm.environment.set(\"token\", json.token);",
									"    pm.environment.set(\"authHeader\", \"Bearer \" + json.token);",
									"    console.log(\"Saved token from login\");",
									"  } else {",
									"    console.log(\"Login response did not include token\");",
									"  }",
									"} catch (e) {",
									"  console.log(\"Login: response parsing failed\", e);",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@quickmenu.local\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login returns { token, tokenType, expiresInMs } - copy token into {{token}} variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "AI Features (Resiliency Tier)",
			"item": [
				{
					"name": "Get Dish Description",
					"request": {
