	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Collection-level Pre-request script: set Authorization header if token exists",
					"if (pm.environment.get(\"token\")) {",
					"  pm.request.headers.upsert({ key: \"Authorization\", value: \"Bearer \" + pm.environment.get(\"token\") });",
					"}",
					"// Generate a random UUID for requestId if not set",
					"if (!pm.environment.get(\"requestId\")) {",
					"    pm.environment.set(\"requestId\", 'req-' + Math.random().toString(36).substring(2, 9));",
					"}"
				]
			}
		}
	],
